{
	"quest.2381C9A50A685885.quest_desc": [
		"My bed is too short for anyone who is not me. Make your own, or a hammock if you like to sleep through the day."
	],
	"quest.2381C9A50A685885.title": "A Place to Sleep",
	"quest.2B304666A309D2B0.quest_desc": [
		"Servus, heir,",
		"",
		"if the notary has done his job, you are standing in front of the Lechnerhof with this letter in your hand and a key that sticks. Lift the door a little, then it turns.",
		"",
		"The house is yours now, and so is everything in it. I am away. Do not ask the notary where; he does not know, and he is not the kind of man who guesses.",
		"",
		"The house is cold and the larder is empty. Start with a fire and something to eat. The rest will come, one letter at a time.",
		"",
		"Your Vinzenz"
	],
	"quest.2B304666A309D2B0.quest_subtitle": "Servus, heir",
	"quest.2B304666A309D2B0.title": "A Letter from the Notary",
	"quest.2D12538F171DB693.quest_desc": [
		"When I walked the hills I carried a bench on a stick. People laughed. Then they borrowed it."
	],
	"quest.2D12538F171DB693.title": "A Bench to Go",
	"quest.441804CDCF855388.quest_desc": [
		"Every house needs a bench. Mine is in the works, under a tarpaulin and forty years of dust. Make yourself a new one; it is quicker than finding the old one."
	],
	"quest.441804CDCF855388.title": "Something to Work On",
	"quest.54C09E6063E7F5EE.quest_desc": [
		"Servus, heir,",
		"",
		"a fire, a bed, bread and iron. Now you live here.",
		"",
		"Go and look at the works behind the barn. Mind the water wheel; it bites.",
		"",
		"Your Vinzenz"
	],
	"quest.54C09E6063E7F5EE.quest_subtitle": "On to the works",
	"quest.54C09E6063E7F5EE.title": "Settled In",
	"quest.613658657F90026D.quest_desc": [
		"A backpack saves you a lot of walking. Take one if you like; the real storage comes later, and it is better."
	],
	"quest.613658657F90026D.title": "A Bag for the Road",
	"quest.63AE6A649A0B6EF9.quest_desc": [
		"The stove in the kitchen still draws. Build a furnace, then a better one; iron burns hotter than stone, and copper is cheap up here."
	],
	"quest.63AE6A649A0B6EF9.title": "A Fire in the Stove",
	"quest.739727889BD5AA79.quest_desc": [
		"The hills are big and my legs were never young enough for them. A warp stone brings you back to the waystones you have found."
	],
	"quest.739727889BD5AA79.title": "The Way Home",
	"quest.7A75F764B8757D32.quest_desc": [
		"Bake bread. A Tyrolean who works on an empty stomach works badly and complains well."
	],
	"quest.7A75F764B8757D32.title": "Something to Eat",
	"quest.7C259418C084CB6C.quest_desc": [
		"The hill behind the house is full of holes. Some of them are mine, most of them are older than the house. Bring back iron and make yourself a pickaxe that does not break on the first good stone."
	],
	"quest.7C259418C084CB6C.title": "Iron from the Hill"
}
