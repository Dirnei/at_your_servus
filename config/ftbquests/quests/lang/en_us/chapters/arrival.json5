{
	"quest.2381C9A50A685885.quest_desc": [
		"My bed went down with the house, and it was too short for anyone but me anyway. Make your own, or a hammock if you like to sleep through the day."
	],
	"quest.2381C9A50A685885.title": "A Place to Sleep",
	"quest.2B304666A309D2B0.quest_desc": [
		"Servus, kid,",
		"",
		"I want you to take my land. I would have given you my house, but there is none anymore. The house went down into the mountain, with the workshop and the cellar. I dug too deep. Sorry about that.",
		"",
		"The land is yours now. I am away. Do not ask me where. I will write to you later.",
		"",
		"Uncle Vinzenz"
	],
	"quest.2B304666A309D2B0.quest_subtitle": "Servus, kid",
	"quest.2B304666A309D2B0.title": "A Letter from the Notary",
	"quest.2D12538F171DB693.quest_desc": [
		"When I walked the mountains I carried a workbench on a stick. People laughed. Then they borrowed it."
	],
	"quest.2D12538F171DB693.title": "A Bench to Go",
	"quest.441804CDCF855388.quest_desc": [
		"Best to punch some trees and start with a workbench. You will need it to make the tools for digging a new mine."
	],
	"quest.441804CDCF855388.title": "Something to Work On",
	"quest.54C09E6063E7F5EE.quest_desc": [
		"Servus, kid,",
		"",
		"I heard you have settled in on the land I gave you.",
		"",
		"Now you should build a place for all the machines. Don't make it too small, you will need the room!",
		"",
		"Uncle Vinzenz"
	],
	"quest.54C09E6063E7F5EE.quest_subtitle": "On to the works",
	"quest.54C09E6063E7F5EE.title": "Settled In",
	"quest.613658657F90026D.quest_desc": [
		"A backpack saves you a lot of walking. Trust me, take one."
	],
	"quest.613658657F90026D.title": "A Bag for the Road",
	"quest.63AE6A649A0B6EF9.quest_desc": [
		"Did you know that you can upgrade your furnace? A copper furnace is cheap up here and works faster than stone."
	],
	"quest.63AE6A649A0B6EF9.title": "A Fire in the Stove",
	"quest.739727889BD5AA79.quest_desc": [
		"The mountains are big and my legs were never young enough for them. A warp stone takes you back to any waystone you have found. Walking teaches you too."
	],
	"quest.739727889BD5AA79.title": "The Way Home",
	"quest.7A75F764B8757D32.quest_desc": [
		"Plant some seeds early. A Bavarian who works on an empty stomach works badly and complains well."
	],
	"quest.7A75F764B8757D32.title": "Something to Eat",
	"quest.7C259418C084CB6C.quest_desc": [
		"The mountain is full of old holes. Some of them are mine, most of them are much older. Bring back iron and make yourself a pickaxe that does not break on the first good stone. Every vein you dig teaches your hands something. Press K and see what they learned."
	],
	"quest.7C259418C084CB6C.title": "Iron from the Hill",
	"reward.247BC2181DCBCD1A.title": "1 Miner point",
	"reward.556483C572E64A8E.title": "1 Wanderer point"
}
