{
	"quest.0085259CDB7378A3.quest_desc": [
		"Eating bread every day makes you strong for a week and grumpy for a year. Eat lots of different foods and your heart grows. Every few new foods give you more health. The Food Book shows what you have eaten so far.",
		"",
		"Tick this off when eating something new has given you your first extra heart."
	],
	"quest.0085259CDB7378A3.title": "Not Just Bread",
	"quest.0FADB4DC7DFA3CCF.quest_desc": [
		"A field can farm only as much as you need. The Field Head learns from its harvests what the field grows. Set \"Harvest up to\" on its Stock tab. Once the warehouse holds that much, the shuttles take a break.",
		"",
		"Tick this off when you have set a harvest limit."
	],
	"quest.0FADB4DC7DFA3CCF.title": "Enough Is Enough",
	"quest.1BB73504AB17A2BB.quest_desc": [
		"Put a Range Upgrade in the Field Head and the field reaches further from its rails. You can use two of them."
	],
	"quest.1BB73504AB17A2BB.title": "Wider Fields",
	"quest.1D0D6510D4687B47.quest_desc": [
		"Every field needs one Field Head next to a farm rail. It keeps the farmland under the rails wet, so it needs water. A fluid pipe from the pump you built in the works is enough. You pick the crop in its window."
	],
	"quest.1D0D6510D4687B47.title": "The Field Head",
	"quest.1F2B0D7C5A26C9C1.quest_desc": [
		"Scraping by hand gets old fast. Honeycomb keeps the copper the way it is, and bees make honeycomb. Find a bee nest and put a campfire under it, so the smoke calms the bees. Then take honey with a glass bottle."
	],
	"quest.1F2B0D7C5A26C9C1.title": "The Bees by the Orchard",
	"quest.2067414B9A11055C.quest_desc": [
		"Put a Harvester on a shuttle in the workshop and send it back to the garage. Once the field has water, a crop and seeds, the warehouse sends it out. It tills, plants, harvests and brings the crop home. A shuttle can only carry one tool, so a harvester will never fetch goods for you."
	],
	"quest.2067414B9A11055C.title": "A Shuttle That Farms",
	"quest.2151BC5EA758717A.quest_desc": [
		"Servus, kid,",
		"",
		"the Huber land once fed half the miners in the valley. Bread, potatoes and honey from the old orchard. Then I started digging and forgot to eat.",
		"",
		"Don't be like me. Before you go down into the cellar, or while you do, get the fields working again. You have rails and shuttles now, and a shuttle does not mind the rain.",
		"",
		"Uncle Vinzenz"
	],
	"quest.2151BC5EA758717A.quest_subtitle": "To be opened when the terminal runs",
	"quest.2151BC5EA758717A.title": "A Man Has to Eat",
	"quest.38D7EBBD388BA1EE.quest_desc": [
		"The copper on the farm rails ages with the water that flows through them. First it gets exposed, then weathered, then oxidized and at last corroded. Every rail ages on its own. A corroded rail stops the water, so every rail behind it dries out. Right-click a rail with an axe and every rail of the field goes back one stage. That costs the axe 4 durability per rail, so bring a good one.",
		"",
		"Tick this off when you have scraped your field."
	],
	"quest.38D7EBBD388BA1EE.title": "Green Copper",
	"quest.38E5000DD8A81B6F.quest_desc": [
		"In the Shuttle Workshop you put tools and upgrades on a shuttle. Later you build better shuttles there too."
	],
	"quest.38E5000DD8A81B6F.title": "The Shuttle Workshop",
	"quest.432B2736D3A64336.quest_desc": [
		"Put seeds in the warehouse and wait. The Field Head keeps a few seeds itself, and the shuttles bring more when it runs low.",
		"",
		"Tick this off when your harvester has brought its first crop into the racks."
	],
	"quest.432B2736D3A64336.title": "The First Harvest",
	"quest.50076B6D3F65F8D6.quest_desc": [
		"Use shears on a full nest to get honeycomb. Make a beehive from it and bring the bees home to your fields. They help the crops too."
	],
	"quest.50076B6D3F65F8D6.title": "Honeycomb",
	"quest.5801EB4AB70EA8A5.quest_desc": [
		"Servus, kid,",
		"",
		"fields that water themselves, shuttles that bring in the harvest and bees that keep the copper bright. I never found out why the bees do that. Some things you just accept. And all that walking between the rows was good for your legs.",
		"",
		"Now nobody on this farm goes hungry. Go and see what the cellar is hiding.",
		"",
		"Uncle Vinzenz"
	],
	"quest.5801EB4AB70EA8A5.quest_subtitle": "The fields feed the farm again",
	"quest.5801EB4AB70EA8A5.title": "A Full Larder",
	"quest.59ECC27C40A34F42.quest_desc": [
		"Farm Rails are warehouse rails with copper on top. All farm rails that touch each other make one field. Lay them through the middle of your farmland and connect them to the warehouse rails, so the shuttles can drive out."
	],
	"quest.59ECC27C40A34F42.title": "Rails Through the Wheat",
	"quest.5E94105094F1EDA2.quest_desc": [
		"On the Field Head's Water tab, pick honeycomb as the anti-corrosion item and keep some in the warehouse. Every time the copper would age, the field uses up one honeycomb instead. The shuttles keep the Field Head stocked.",
		"",
		"Tick this off when your field holds its copper."
	],
	"quest.5E94105094F1EDA2.title": "Wax on the Rails",
	"quest.63BFAE73E24EC3E1.quest_desc": [
		"A shuttle with a Spreader brings fertilizer to the field. Choose the fertilizer and the mode in the Field Head and keep bone meal in the warehouse. The crops grow faster and the harvesters get more work."
	],
	"quest.63BFAE73E24EC3E1.title": "The Spreader",
	"reward.2BE5CD1EA001175B.title": "1 Wanderer point"
}
