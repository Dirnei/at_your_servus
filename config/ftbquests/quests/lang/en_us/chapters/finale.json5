{
	"quest.09CA56FB7BED0F7C.quest_desc": [
		"Piles to nuggets, nuggets to an ingot. Heavier than anything I ever held. My letters get shorter from here on. I was busy."
	],
	"quest.09CA56FB7BED0F7C.title": "Neutronium",
	"quest.32141C65FFD7D602.quest_desc": [
		"The Neutron Compressor squeezes a mountain of one thing into a single point. Order the metals from the warehouse. The shuttles don't complain."
	],
	"quest.32141C65FFD7D602.title": "Singularities",
	"quest.3DD3AEC10463CF6B.quest_desc": [
		"The plans for the armour are the last page of my notebook. The rest is blank."
	],
	"quest.3DD3AEC10463CF6B.title": "Armour Beyond Alchemy",
	"quest.466734D4A1C805D1.quest_desc": [
		"The Neutron Collector gathers neutron dust out of thin air, very slowly. Just leave it running. The warehouse can wait for it, you don't have to."
	],
	"quest.466734D4A1C805D1.title": "Out of Nothing",
	"quest.4E9A3566662564B7.quest_desc": [
		"Everything I had, in one thing. Caput Mortuum from the red fire, quicksilver, the undying flame, the Crafting CPU from the warehouse and the brightest crystal from the power station.",
		"",
		"This is where my notes stop making sense."
	],
	"quest.4E9A3566662564B7.title": "The Infinity Catalyst",
	"quest.5664C85D8433520D.quest_desc": [
		"I made one ingot. Then I heard the knocking."
	],
	"quest.5664C85D8433520D.title": "Infinity",
	"quest.5A2CD20BC517419E.quest_desc": [
		"Servus, kid,",
		"",
		"alchemy can make everything that exists. I wanted to make something that does not exist yet.",
		"",
		"There is a matter heavier than lead and older than the mountain. I found a way to gather it out of nothing, grain by grain. Build the big table first. It is nine by nine, because the work doesn't fit in three anymore.",
		"",
		"Uncle Vinzenz"
	],
	"quest.5A2CD20BC517419E.quest_subtitle": "To be opened after the red fire",
	"quest.5A2CD20BC517419E.title": "Beyond Alchemy",
	"quest.783CE7103F14F12B.quest_desc": [
		"The Extreme Crafting Table. My hands shook the first time I filled it."
	],
	"quest.783CE7103F14F12B.title": "The Big Table",
	"quest.7A6D3546A0BF0C9C.quest_desc": [
		"Servus, kid,",
		"",
		"if you are reading this, you made what I could only draw. Good. I knew the farm would be in better hands.",
		"",
		"I did not die. I went down after the knocking and the mountain closed behind me. Sorry about the house. The old one was waiting for me, the same one who once waited for Paracelsus. There is work down here that no alchemy can do. The veins need looking after, and someone has to listen to the mountain. I am slow now, and very happy.",
		"",
		"I left you one last trick each for the pick, the sword and the road. Press K.",
		"",
		"Don't come looking for me. Leave a pinch of salt in the deepslate now and then and listen. If it knocks twice, that is me.",
		"",
		"The trading company is yours now. Keep the books straight.",
		"",
		"Servus,",
		"Uncle Vinzenz"
	],
	"quest.7A6D3546A0BF0C9C.quest_subtitle": "Found where the dust trickles from one block",
	"quest.7A6D3546A0BF0C9C.title": "Servus",
	"quest.7B00A3D3FA209A58.quest_desc": [
		"Diamonds and nether stars, woven together. Hard work, but worth it."
	],
	"quest.7B00A3D3FA209A58.title": "Crystal Matrix",
	"reward.304921D69C4E18F5.title": "1 Miner point",
	"reward.622415F2D20B58DB.title": "1 Hunter point",
	"reward.65B5D35224AA2D64.title": "1 Wanderer point"
}
