{
	"quest.002D274F79E0F1A7.quest_desc": [
		"The Crafting CPU owns the orders. You ask for 64 of something; it works out the steps and sends the work out. Patterns go into Pattern Storage."
	],
	"quest.002D274F79E0F1A7.title": "The Crafting CPU",
	"quest.027B3F69BB9C4EE0.quest_desc": [
		"Servus, heir,",
		"",
		"racks, shuttles, fields, outposts, and orders that run down into the cellar and back. Our ancestors would not believe it, and they believed a great deal.",
		"",
		"Now nothing waits on a man. Everything waits on an order.",
		"",
		"Your Vinzenz"
	],
	"quest.027B3F69BB9C4EE0.quest_subtitle": "Lechner & Compagnie, since 1521",
	"quest.027B3F69BB9C4EE0.title": "Open for Business",
	"quest.0346EE683D2E3D5B.quest_desc": [
		"The Production Terminal is where you place orders and watch them run."
	],
	"quest.0346EE683D2E3D5B.title": "The Order Book",
	"quest.0D81246D3E24A6F2.quest_desc": [
		"Zone Labels tell the shuttles where things belong: ores here, food there, salt by the cellar door. Put-away rules, the old factors called it."
	],
	"quest.0D81246D3E24A6F2.title": "A Place for Everything",
	"quest.0DE6C555E6857962.quest_desc": [
		"Every controller is a site. A Wireless Upgrade links the sites, and an Anchor Upgrade wakes an outpost when the shuttles need it. The trading house now has branches, as it did in 1530."
	],
	"quest.0DE6C555E6857962.title": "Outposts",
	"quest.118E97534B2C15B0.quest_desc": [
		"An Inbound Station takes what you drop in and gives it to the shuttles to put away. No more emptying your pockets by hand."
	],
	"quest.118E97534B2C15B0.title": "Goods In",
	"quest.23D4CF623A339876.quest_desc": [
		"A Range Upgrade lets a Field Head reach further."
	],
	"quest.23D4CF623A339876.title": "Wider Fields",
	"quest.29DFE735FD7B04E9.quest_desc": [
		"In the workshop you build better shuttles by hand. The Mk2 is faster and carries more."
	],
	"quest.29DFE735FD7B04E9.title": "The Shuttle Workshop",
	"quest.2BD4188C47A9639B.quest_desc": [
		"Lay Farm Rails along the fields. A shuttle with a Field Head and a Harvester brings in the crops; one with a Spreader sows them again. One tool per shuttle."
	],
	"quest.2BD4188C47A9639B.title": "Shuttles in the Field",
	"quest.2CFAA1B93AE63A3B.quest_desc": [
		"The Crafting Station does the crafting table's job, only without you."
	],
	"quest.2CFAA1B93AE63A3B.title": "A Station That Crafts",
	"quest.3A961E71BE94081E.quest_desc": [
		"Servus, heir,",
		"",
		"with power in the house, the warehouse can grow up. Our ancestors had factors in Augsburg and Venice and a counting house that never slept. You will have shuttles. They do not sleep either, and they never fiddle the books.",
		"",
		"Your Vinzenz"
	],
	"quest.3A961E71BE94081E.quest_subtitle": "To be opened when the station runs",
	"quest.3A961E71BE94081E.title": "Lechner & Compagnie",
	"quest.417B1F295DEFA19E.quest_desc": [
		"The Mk3 with speed and handling upgrades. If it were a horse it would win in Meran."
	],
	"quest.417B1F295DEFA19E.title": "The Mk3",
	"quest.45EE84C114D74E1A.quest_desc": [
		"Fast and duplex data cables carry more orders at once, for when the counting house gets busy."
	],
	"quest.45EE84C114D74E1A.title": "Faster Lines",
	"quest.52284641AD471883.quest_desc": [
		"Only storage touches the rails. Everything else talks over the data cable, and the controller sits on both."
	],
	"quest.52284641AD471883.title": "The Data Cable",
	"quest.5ACB69B7A0BCDD39.quest_desc": [
		"Servus, heir,",
		"",
		"this is the thing I dreamed of: the counting house orders, and the cellar delivers. Connect an alchemy machine to the data cable, with a Machine Adapter where it needs one, and order its product through the Crafting CPU. Nothing runs without an order, and nothing waits on a man.",
		"",
		"Tick this off when your first order came back from the cellar.",
		"",
		"Your Vinzenz"
	],
	"quest.5ACB69B7A0BCDD39.quest_subtitle": "The warehouse orders from the alchemist",
	"quest.5ACB69B7A0BCDD39.title": "An Order to the Cellar",
	"quest.5E06A1198AE4F57D.quest_desc": [
		"The Packing Station gathers what an order needs and packs it for the machine that does the work."
	],
	"quest.5E06A1198AE4F57D.title": "Packed and Ready",
	"quest.6800E2669EDBDA30.quest_desc": [
		"An Outbound Station hands goods out to a machine or a chest, ready for the next step."
	],
	"quest.6800E2669EDBDA30.title": "Goods Out"
}
