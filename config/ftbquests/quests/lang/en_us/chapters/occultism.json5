{
	"quest.03C600E3ADFC4F84.quest_desc": [
		"A familiar follows you and helps in its own odd way."
	],
	"quest.03C600E3ADFC4F84.title": "A Familiar",
	"quest.0E599C2173D6F65A.quest_desc": [
		"Bind a foliot into a book and give it a job. Spirits that carry things are handy next to the warehouse."
	],
	"quest.0E599C2173D6F65A.title": "A Spirit That Works",
	"quest.1C54D04D7B4AE09E.quest_desc": [
		"Grow datura and dream. The dreams show another world beneath this one."
	],
	"quest.1C54D04D7B4AE09E.title": "Demon's Dream",
	"quest.3E82DF3747B69304.quest_desc": [
		"White chalk for the pentacle, golden sacrificial bowls for the offerings. Rituals want both."
	],
	"quest.3E82DF3747B69304.title": "Chalk and a Golden Bowl",
	"quest.4586E27337CD6680.quest_desc": [
		"Otherworld goggles let you see what the dream showed you."
	],
	"quest.4586E27337CD6680.title": "Eyes for the Otherworld",
	"quest.6F26B2D3457373F8.quest_desc": [
		"Vinzenz kept this book on the same shelf as the journal, upside down. \"Paracelsus' spirits are elements,\" he wrote inside. \"These are something else. Be polite.\""
	],
	"quest.6F26B2D3457373F8.title": "A Dictionary of Spirits"
}
