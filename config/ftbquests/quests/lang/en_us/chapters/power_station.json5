{
	"quest.03C51FF98930E412.quest_desc": [
		"Servus, kid,",
		"",
		"a warehouse eats a lot of power, and the cellar will too. The Coal Generator was never meant to last. Here are my plans for a real power station.",
		"",
		"It runs on crystals, because the old way is too slow. Don't ask me how the crystals work. I only know that they do.",
		"",
		"Uncle Vinzenz"
	],
	"quest.03C51FF98930E412.quest_subtitle": "To be opened when the coal runs low",
	"quest.03C51FF98930E412.title": "Plans for a Power Station",
	"quest.04F7FFC89A9F1568.quest_desc": [
		"The sun shines up here more than people think. Put a solar panel on the roof, it pays for itself."
	],
	"quest.04F7FFC89A9F1568.title": "Power from the Sky",
	"quest.0D4F7480EF07FEE4.quest_desc": [
		"Emeralds this time. At night you can hear the station hum."
	],
	"quest.0D4F7480EF07FEE4.title": "Spirited Crystals",
	"quest.10EA0AD4F14C8455.quest_desc": [
		"An energy cell stores power for later, so the night shift has something to run on."
	],
	"quest.10EA0AD4F14C8455.title": "Keep It for Later",
	"quest.20C10398C80B7AC1.quest_desc": [
		"The Furnator burns fuel like the Coal Generator, only much better. Connect it to the power line in the duct and the warehouse uses the power as it comes."
	],
	"quest.20C10398C80B7AC1.title": "A Better Fire",
	"quest.234A33DE8B99D80B.quest_desc": [
		"The Magmator turns lava into power. And the Nether has more lava than sense."
	],
	"quest.234A33DE8B99D80B.title": "Lava Into Power",
	"quest.265ADA96575398B8.quest_desc": [
		"Next the orb wants blaze powder. That means going to the Nether. Read the next letter first."
	],
	"quest.265ADA96575398B8.title": "Blazing Crystals",
	"quest.289B7185D4FB7D03.quest_desc": [
		"My plans end with a reactor. You need uraninite, a lot of reactor casing and cooling. Build it as big as you dare."
	],
	"quest.289B7185D4FB7D03.title": "The Reactor",
	"quest.2B87EC827F6BE958.quest_desc": [
		"Diamonds, charged until they glow. Expensive, but worth it."
	],
	"quest.2B87EC827F6BE958.title": "Niotic Crystals",
	"quest.37EC81C2FB9FE7DE.quest_desc": [
		"Hardened capacitors and hardened rods make the orb twice as good."
	],
	"quest.37EC81C2FB9FE7DE.title": "Hardened Parts",
	"quest.43A4B9260903A45A.quest_desc": [
		"Servus, kid,",
		"",
		"nitro crystals. I only ever made one and it took me the whole winter. If you have made a stack, the station is done and the farm has power for a hundred years.",
		"",
		"Uncle Vinzenz"
	],
	"quest.43A4B9260903A45A.quest_subtitle": "The station is finished",
	"quest.43A4B9260903A45A.title": "Nitro Crystals",
	"quest.6778FDF9D976FE27.quest_desc": [
		"Everything in the station starts with dielectric paste. Clay, charcoal and a bit of lava. It's messy, but it holds."
	],
	"quest.6778FDF9D976FE27.title": "Dielectric Paste",
	"quest.6AD9185040B4C27E.quest_desc": [
		"Iron and gold, charged together. The whole station is built from it."
	],
	"quest.6AD9185040B4C27E.title": "Energized Steel",
	"quest.6F7A61773363C076.quest_desc": [
		"The orb charges whatever you put in it, as long as the rods give it power. Put the starter rods around it and feed them power from the duct."
	],
	"quest.6F7A61773363C076.title": "The Energizing Orb"
}
