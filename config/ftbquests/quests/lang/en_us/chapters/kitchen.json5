{
	"quest.245548D421AF9F14.quest_desc": [
		"A sink in the kitchen gives the Cooking Table water for its recipes, so you can stop carrying buckets."
	],
	"quest.245548D421AF9F14.title": "Running Water",
	"quest.2471EBEE8A932176.quest_desc": [
		"Counters and cabinets store your ingredients. Put them next to the Cooking Table so they touch each other, and the table uses everything in them."
	],
	"quest.2471EBEE8A932176.title": "Counters and Cabinets",
	"quest.24C9A3F9329AA861.quest_desc": [
		"A Cooking Table knows every recipe you can make with what you have. On its own it looks in your pockets. With a kitchen around it, it looks in the whole kitchen."
	],
	"quest.24C9A3F9329AA861.title": "A Proper Kitchen",
	"quest.4E2517288D36B4F4.quest_desc": [
		"An oven bakes and roasts several things at once. As part of the kitchen it lets the Cooking Table cook things that need a fire. You can dye it later."
	],
	"quest.4E2517288D36B4F4.title": "The Oven",
	"quest.5CED034112EE4899.quest_desc": [
		"A spice rack, a toaster and a milk jar. You don't need any of them, but they are nice to have."
	],
	"quest.5CED034112EE4899.title": "Little Helpers",
	"quest.6791276511DE73AA.quest_desc": [
		"With a whole kitchen you can cook dishes you have never tasted. Every new food counts. Eat enough different ones and you get more hearts. The Food Book keeps the list."
	],
	"quest.6791276511DE73AA.title": "What Have You Eaten?",
	"quest.68ECC27E57EBEBDC.quest_desc": [
		"A fridge keeps food in the kitchen. Two fridges stacked make a tall one."
	],
	"quest.68ECC27E57EBEBDC.title": "Cold Storage",
	"quest.6E8C02F62BA4A3BE.quest_desc": [
		"The Recipe Book shows every dish you can cook from what is in your pockets. Vinzenz's own cookbook had three recipes in it, all of them for dumplings."
	],
	"quest.6E8C02F62BA4A3BE.title": "No Recipe Without a Book"
}
