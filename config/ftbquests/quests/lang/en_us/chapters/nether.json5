{
	"quest.070313A3842B9B2B.quest_desc": [
		"Blazegold armour and a blazegold sword. Now the Nether can come to you."
	],
	"quest.070313A3842B9B2B.title": "Dressed for the Fire",
	"quest.0950ABF989872683.quest_desc": [
		"Gold that remembers the fire. Lighter than ferricore and better in the heat."
	],
	"quest.0950ABF989872683.title": "Blazegold",
	"quest.1F20A0D4E7AEDB3A.quest_desc": [
		"The blazes guard the fortresses. Their rods feed the power station's orb and the yellow fire in the cellar alike."
	],
	"quest.1F20A0D4E7AEDB3A.title": "Blaze Rods",
	"quest.412F1A7E34921AF9.quest_desc": [
		"A lava immunity upgrade in your boots, and you can swim where the salamanders live."
	],
	"quest.412F1A7E34921AF9.title": "Lava Is Just Hot Water",
	"quest.4D70AA36144CB43C.quest_desc": [
		"Obsidian and a spark. Step through with a full belly."
	],
	"quest.4D70AA36144CB43C.title": "The Gate",
	"quest.57C7FD54FBD0265B.quest_desc": [
		"Ferricore armour and tools. Put upgrades in them; the goo taught them tricks."
	],
	"quest.57C7FD54FBD0265B.title": "Armour That Learned Something",
	"quest.59A48D2CFD9C8738.quest_desc": [
		"Servus, heir,",
		"",
		"the journal speaks of a salamander, a spirit of fire that lives beyond the gate. With the yellow fire burning in the cellar you can bind one to a forge. I did. It sulks, but it works.",
		"",
		"Your Vinzenz"
	],
	"quest.59A48D2CFD9C8738.quest_subtitle": "Journal: The Wandering Years",
	"quest.59A48D2CFD9C8738.title": "The Fire-Spirit",
	"quest.6737F16866B90111.quest_desc": [
		"Note on the second barrel: \"Feed it ferricore and it wants more. Give it gold in the Nether and it gives back gold that burns."
	],
	"quest.6737F16866B90111.title": "Hungrier Goo",
	"quest.6EBD0ECB585A81CD.quest_desc": [
		"Note on the barrel: \"Feed it an iron block. Wait. Do not touch it while it works. Do not lick it either; once was enough."
	],
	"quest.6EBD0ECB585A81CD.title": "Primal Goo",
	"quest.6FB8337E4C884831.quest_desc": [
		"Servus, heir,",
		"",
		"the fire you need lives beyond the burning gate. The journal says so, and so do my burns.",
		"",
		"Do not go in iron. Down in the old shaft I found a strange green goo that eats metal and gives back something better. My notes on it are pinned to the barrel. Go armoured, go fed, and come back.",
		"",
		"Your Vinzenz"
	],
	"quest.6FB8337E4C884831.quest_subtitle": "To be opened before the Nether",
	"quest.6FB8337E4C884831.title": "Beyond the Burning Gate",
	"quest.76A6CCC8C9A258F0.quest_desc": [
		"What the goo leaves behind smelts into ferricore: iron that has learned something."
	],
	"quest.76A6CCC8C9A258F0.title": "Ferricore"
}
