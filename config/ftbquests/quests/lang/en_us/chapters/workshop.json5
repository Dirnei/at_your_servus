{
	"quest.14D64835D461CD98.quest_desc": [
		"A player transmitter sends the station's power to whatever you carry. No more walking back to recharge."
	],
	"quest.14D64835D461CD98.title": "Charging on the Move",
	"quest.1B7068D5F30A7EA3.quest_desc": [
		"From here on, each jetpack needs quicksilver from the cellar. Mercury is the spirit that rises as vapour. Paracelsus knew it; my thrusters learned it."
	],
	"quest.1B7068D5F30A7EA3.title": "A Diamond Jetpack",
	"quest.1B7BC5E9352BCBF4.quest_desc": [
		"Heavy, loud and wonderful. Charge it at the station and jump."
	],
	"quest.1B7BC5E9352BCBF4.title": "An Iron Jetpack",
	"quest.1DE516629AD26E28.quest_desc": [
		"Emeralds and quicksilver. I flew to the top of the Kellerjoch with this one and nearly did not come down."
	],
	"quest.1DE516629AD26E28.title": "An Emerald Jetpack",
	"quest.2037DD58BC0394C0.quest_desc": [
		"Servus, heir,",
		"",
		"netherite from the Prelum, quicksilver and the undying flame. This is the one I used to search the deep shafts for the knocking. It is the best thing I ever built, apart from the trading house, and that was not my idea.",
		"",
		"Your Vinzenz"
	],
	"quest.2037DD58BC0394C0.quest_subtitle": "My best work",
	"quest.2037DD58BC0394C0.title": "The Netherite Jetpack",
	"quest.4FF66CC1B301897A.quest_desc": [
		"Gold carries the charge further. Faster, and it holds more."
	],
	"quest.4FF66CC1B301897A.title": "A Gold Jetpack",
	"quest.5696345D0B8FCA0A.quest_desc": [
		"Servus, heir,",
		"",
		"the key on the blue ribbon opens my workshop above the barn. Inside is the only thing I ever invented that I am proud of: a jetpack.",
		"",
		"The mountain is full of shafts and I was too old for ladders. The first ones run on power from the station. The good ones need quicksilver, the spirit that rises. You will see why.",
		"",
		"Your Vinzenz"
	],
	"quest.5696345D0B8FCA0A.quest_subtitle": "To be opened when the station runs",
	"quest.5696345D0B8FCA0A.title": "The Locked Workshop",
	"quest.7BD368D3E78DBC5A.quest_desc": [
		"A strap to carry it, a coil to drive it. Everything else is just more of the same."
	],
	"quest.7BD368D3E78DBC5A.title": "Strap and Coil"
}
